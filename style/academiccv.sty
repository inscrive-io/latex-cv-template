% =====================================================================
%  academiccv.sty
%  A modern single-column academic CV style for pdfLaTeX.
%  ---------------------------------------------------------------
%  Single column is deliberate: it is what hiring and grant committees
%  expect, it survives being printed, and it never truncates a long
%  publication list. Everything visual lives here; start at SECTION 1.
% =====================================================================
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{style/academiccv}[2026/09/15 v1.0 Modern academic CV style]

% ---------------------------------------------------------------------
%  1. BRAND  --  change these and the whole CV follows
% ---------------------------------------------------------------------
\RequirePackage{xcolor}
\definecolor{accent}    {HTML}{4F46E5} % rules, icons, links
\definecolor{accentdark}{HTML}{3730A3}
\definecolor{ink}       {HTML}{111827} % name and body text
\definecolor{muted}     {HTML}{4B5563} % dates, secondary detail (7:1 on white)
\definecolor{hairline}  {HTML}{E5E7EB}
\definecolor{surface}   {HTML}{F5F6FB}

% Width of the left-hand date column, and the gap after it.
\newlength{\cvdatewidth}\setlength{\cvdatewidth}{23mm}
\newlength{\cvgutter}   \setlength{\cvgutter}{5mm}
\newlength{\cventrysep} \setlength{\cventrysep}{7pt}

% ---------------------------------------------------------------------
%  2. FONTS  --  pdfLaTeX only, so compilation stays fast
% ---------------------------------------------------------------------
\RequirePackage[T1]{fontenc}
\RequirePackage[utf8]{inputenc}
\RequirePackage{libertinus}
\RequirePackage[scaled=0.94]{FiraSans}
\RequirePackage[scaled=0.86]{FiraMono}
\RequirePackage{microtype}
\RequirePackage{fontawesome5}

% ---------------------------------------------------------------------
%  3. PAGE
% ---------------------------------------------------------------------
\RequirePackage[a4paper,top=20mm,bottom=20mm,left=22mm,right=22mm,
                footskip=14mm,headheight=14pt]{geometry}
\RequirePackage{setspace}\setstretch{1.05}
\setlength{\parindent}{0pt}
\setlength{\emergencystretch}{1.2em}
\RequirePackage{needspace}
\RequirePackage{lastpage}
\RequirePackage{fancyhdr}
\RequirePackage{enumitem}
\RequirePackage{tabularx}
\RequirePackage{booktabs}
\RequirePackage{ifthen}
\RequirePackage{graphicx}
\RequirePackage{accsupp}
\RequirePackage{siunitx}
\sisetup{detect-all=true}

\pagestyle{fancy}
\fancyhf{}
\renewcommand{\headrulewidth}{0pt}
\fancyfoot[L]{\sffamily\footnotesize\color{muted}\cvfootname}
\fancyfoot[R]{\sffamily\footnotesize\color{muted}\thepage\ / \pageref{LastPage}}

% ---------------------------------------------------------------------
%  4. METADATA  --  set these in main.tex
% ---------------------------------------------------------------------
\newcommand{\cvname}[1]      {\def\@cvname{#1}}
\newcommand{\cvrole}[1]      {\def\@cvrole{#1}}
\newcommand{\cvaffiliation}[1]{\def\@cvaffiliation{#1}}
\newcommand{\cvemail}[1]     {\def\@cvemail{#1}}
\newcommand{\cvphone}[1]     {\def\@cvphone{#1}}
\newcommand{\cvweb}[1]       {\def\@cvweb{#1}}
\newcommand{\cvlocation}[1]  {\def\@cvlocation{#1}}
\newcommand{\cvorcid}[1]     {\def\@cvorcid{#1}}
\newcommand{\cvgithub}[1]    {\def\@cvgithub{#1}}
\newcommand{\cvlogo}[1]      {\def\@cvlogo{#1}}
\newcommand{\cvfootname}     {\@cvname\ \textperiodcentered\ Curriculum Vitae}
\cvname{Your Name}\cvrole{}\cvaffiliation{}\cvemail{}\cvphone{}
\cvweb{}\cvlocation{}\cvorcid{}\cvgithub{}\cvlogo{}

% ---------------------------------------------------------------------
%  5. HEADER
% ---------------------------------------------------------------------
% Contact items separate themselves with a thin divider, and the
% divider is skipped before the first one, so leaving a field empty
% never leaves a stray separator behind.
\newif\ifcv@first
\newcommand{\cv@sep}{%
  \ifcv@first\cv@firstfalse\else
    % kern, not glue, so a line never breaks just before the divider:
    % the divider always ends the line it belongs to.
    \kern3.2mm{\color{hairline}\rule[-0.35ex]{0.6pt}{1.5ex}}\kern3.2mm\allowbreak
  \fi}
% The icon is decoration; ActualText is what an ATS, a screen reader or
% a copy-paste actually receives in its place.
\newcommand{\cv@icon}[2]{%
  \BeginAccSupp{method=escape,ActualText={#2}}\textcolor{accent}{#1}\EndAccSupp{}}
\newcommand{\cv@item}[3]{\cv@sep\cv@icon{#1}{#2}\,\;#3}

\newcommand{\makecvheader}{%
  \begingroup
  \sffamily
  \noindent
  \begin{minipage}[b]{\dimexpr\textwidth-46mm\relax}
    {\fontsize{26}{30}\selectfont\bfseries\color{ink}\@cvname\par}
    \ifx\@cvrole\@empty\else
      \vspace{1.5mm}{\normalsize\color{muted}\@cvrole\par}
    \fi
    \ifx\@cvaffiliation\@empty\else
      {\small\color{muted}\@cvaffiliation\par}
    \fi
  \end{minipage}%
  \hfill
  \begin{minipage}[b]{44mm}\raggedleft
    % Fits any logo shape: never wider than 44mm, never taller than 15mm.
    \ifx\@cvlogo\@empty\else
      \includegraphics[width=44mm,height=15mm,keepaspectratio]{\@cvlogo}
    \fi
  \end{minipage}
  \par\vspace{4mm}
  {\color{accent}\rule{\textwidth}{1.2pt}}
  \par\vspace{2.5mm}
  {\footnotesize\color{ink}\raggedright\cv@firsttrue
    \ifx\@cvemail\@empty\else\cv@item{\faEnvelope}{Email: }{\href{mailto:\@cvemail}{\@cvemail}}\fi
    \ifx\@cvphone\@empty\else\cv@item{\faPhone*}{Phone: }{\@cvphone}\fi
    \ifx\@cvweb\@empty\else\cv@item{\faGlobe}{Web: }{\href{https://\@cvweb}{\@cvweb}}\fi
    \ifx\@cvorcid\@empty\else\cv@item{\faOrcid}{ORCID: }{\href{https://orcid.org/\@cvorcid}{\@cvorcid}}\fi
    \ifx\@cvgithub\@empty\else\cv@item{\faGithub}{GitHub: }{\href{https://github.com/\@cvgithub}{\@cvgithub}}\fi
    \ifx\@cvlocation\@empty\else\cv@item{\faMapMarker*}{Location: }{\@cvlocation}\fi
  \par}
  \par\vspace{1mm}
  \endgroup
  \rmfamily
}

% ---------------------------------------------------------------------
%  6. SECTIONS AND ENTRIES
% ---------------------------------------------------------------------
\newcommand{\cvsection}[1]{%
  \Needspace{4\baselineskip}%
  \vspace{6mm}%
  {\sffamily\bfseries\footnotesize\color{accent}\MakeUppercase{#1}}\par
  \vspace{1mm}{\color{hairline}\rule{\textwidth}{0.8pt}}\par
  \vspace{3mm}%
}

% \cventry{dates}{role}{organisation}{extra}{body}
%   Any argument may be left empty.
\newcommand{\cventry}[5]{%
  \Needspace{3\baselineskip}%
  \noindent
  \begin{minipage}[t]{\cvdatewidth}\raggedright
    {\sffamily\footnotesize\color{muted}#1}
  \end{minipage}\hspace{\cvgutter}%
  \begin{minipage}[t]{\dimexpr\textwidth-\cvdatewidth-\cvgutter\relax}
    {\sffamily\bfseries\color{ink}#2}%
    \ifthenelse{\equal{#4}{}}{}{\hfill{\sffamily\footnotesize\color{muted}#4}}\par
    \ifthenelse{\equal{#3}{}}{}{{\color{muted}#3}\par}
    \ifthenelse{\equal{#5}{}}{}{\vspace{1mm}#5\par}
  \end{minipage}
  \par\vspace{\cventrysep}%
}

% \cvline{dates}{text}  --  for one-line items such as awards or talks
\newcommand{\cvline}[2]{%
  \noindent
  \begin{minipage}[t]{\cvdatewidth}\raggedright
    {\sffamily\footnotesize\color{muted}#1}
  \end{minipage}\hspace{\cvgutter}%
  \begin{minipage}[t]{\dimexpr\textwidth-\cvdatewidth-\cvgutter\relax}#2\end{minipage}
  \par\vspace{4pt}%
}

% \cvskill{label}{comma separated items}
\newcommand{\cvskill}[2]{%
  \noindent
  \begin{minipage}[t]{\cvdatewidth}\raggedright
    {\sffamily\footnotesize\bfseries\color{ink}#1}
  \end{minipage}\hspace{\cvgutter}%
  \begin{minipage}[t]{\dimexpr\textwidth-\cvdatewidth-\cvgutter\relax}#2\end{minipage}
  \par\vspace{4pt}%
}

% A small pill, handy for keywords or methods.
\newcommand{\cvtag}[1]{%
  \tikz[baseline=(t.base)]{\node[fill=surface,draw=hairline,rounded corners=2pt,
        inner xsep=4pt,inner ysep=2pt,font=\sffamily\footnotesize\color{ink}] (t) {#1};}%
}
\RequirePackage{tikz}

% Compact bullet list for entry bodies.
\newlist{cvitems}{itemize}{1}
\setlist[cvitems]{leftmargin=1.1em,topsep=1pt,itemsep=1pt,parsep=0pt,
                  label=\textcolor{accent}{\footnotesize\textbullet}}

% ---------------------------------------------------------------------
%  7. PUBLICATIONS
%     Newest first, numbered per group, and your own name in bold.
% ---------------------------------------------------------------------
\RequirePackage[backend=biber,style=numeric,sorting=ydnt,defernumbers=true,
                giveninits=true,maxbibnames=12,minbibnames=12,
                isbn=false,url=false,doi=true]{biblatex}
\renewcommand*{\bibfont}{\small}
\setlength{\bibitemsep}{0.5em}
\DeclareFieldFormat{titlecase}{#1}

% Family name to print in bold in every reference list.
\newcommand{\cvbibname}[1]{\def\@cvbibname{#1}}
\cvbibname{}
\renewcommand*{\mkbibnamefamily}[1]{%
  \ifthenelse{\equal{#1}{\@cvbibname}}{\textbf{#1}}{#1}}

% \cvpublications{bibtype}{heading}{prefix}
%   One numbered group per publication type. The prefix keeps the
%   numbers unambiguous across groups: J1 is a journal article, C1 a
%   conference paper, so a reference to "C2" can only mean one thing.
\newcommand{\cvpublications}[3]{%
  \cvsection{#2}%
  \newrefcontext[labelprefix={#3}]%
  \printbibliography[type=#1,heading=none,resetnumbers=true]%
  \endrefcontext
}

% ---------------------------------------------------------------------
%  8. LINKS
% ---------------------------------------------------------------------
\RequirePackage[hidelinks]{hyperref}
\hypersetup{colorlinks=true,linkcolor=accentdark,urlcolor=accentdark,
            citecolor=accentdark,pdfborder={0 0 0},pdflang={en-GB}}
\urlstyle{same}
% Identify the file in the PDF properties, so it is not an untitled blob
% in a reader, a shared drive or an application portal.
% Strip spacing macros before hyperref turns the name into a PDF string.
\pdfstringdefDisableCommands{%
  \let\,\space \let\;\space \let\:\space \let\!\relax
  \def\textperiodcentered{-}%
}
\AtBeginDocument{%
  \hypersetup{pdftitle={\@cvname\space--\space Curriculum Vitae},
              pdfauthor={\@cvname},pdfsubject={Curriculum Vitae},
              pdfcreator={pdfLaTeX}}%
}
\endinput
